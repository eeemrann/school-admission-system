root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

[*.{csproj,props,targets,xml}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{ts,tsx,js,jsx,json}]
indent_style = space
indent_size = 2
tab_width = 2

# EF Core generates this migration without the generated-code marker while its
# constant column arrays trigger CA1861. Keep the exception limited to this
# exact migration file; other migrations and all unrelated source remain
# covered by the normal analyzer settings.
[backend/src/SchoolAdmission.Infrastructure/Persistence/Migrations/20261109184037_InitialCreate.cs]
dotnet_diagnostic.CA1861.severity = none

[*.{yml,yaml}]
indent_style = space
indent_size = 2
tab_width = 2

[*.md]
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = off
